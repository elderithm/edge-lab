# DreamDEX Perps bridge configuration (Somnia Hideki Testnet, chain id 50383).
# Copy to `.env` (gitignored) and fill in. NEVER commit a real .env or a real key.
# Perps is configured SEPARATELY from the Event Contracts bridge (../dreamdex-bridge),
# which stays on Somnia Shannon Testnet (50312) with its own SDK version.

# Writes require BOTH of these exact values. Reads work regardless.
NETWORK=hideki-testnet
TRADING_MODE=paper           # paper | testnet  (there is no mainnet perps mode)

# Official Hideki endpoints (defaults built in; override only if DreamDEX changes them).
PERPS_INDEXER_URL=https://hideki-dev.smk.somnia.host/v1/graphql
PERPS_RPC_URL=https://api.hideki2.infra.testnet.somnia.network
PERPS_WS_RPC_URL=wss://api.hideki2.infra.testnet.somnia.network/ws

# Optional PUBLIC address for read-only account views (equity, positions, sizing).
PERPS_ACCOUNT=

# Dedicated, throwaway Hideki TESTNET signer ONLY. Never a main-wallet key.
# Deliberately a different variable from the Event Contracts PRIVATE_KEY.
PERPS_PRIVATE_KEY=

# Bridge-side hard cap per order, in quote units (USDso). Python enforces its own
# (lower or equal) limits first; this is defence in depth.
PERPS_MAX_ORDER_NOTIONAL=100
