# DreamDEX bridge configuration (Somnia Event Contracts).
# Copy to `.env` and fill in. NEVER commit a real .env or a real private key.

# Network: "testnet" (Somnia Shannon, chainId 50312) or "mainnet" (Somnia, 5031).
# Default is testnet. Mainnet also requires ENABLE_MAINNET_TRADING=true AND
# TRADING_MODE=mainnet, and is never inferred implicitly.
NETWORK=testnet

# Trading mode: paper | testnet | mainnet. Default paper.
# paper   -> reads only; no signer needed; no transactions.
# testnet -> may submit Shannon Testnet transactions; requires PRIVATE_KEY.
# mainnet -> disabled unless ENABLE_MAINNET_TRADING=true (do not use for the hackathon).
TRADING_MODE=paper

# Indexer + RPC endpoints (see DreamDEX / Somnia docs for current URLs).
# The chain definition ships sensible defaults; override only if needed.
INDEXER_URL=
WS_RPC_URL=
RPC_URL=

# Dedicated hackathon TESTNET signer ONLY. Never a main-wallet seed/key.
# Leave blank in paper mode. Injected via environment/secret, never committed.
PRIVATE_KEY=

# Hard gate for mainnet writes. Must be exactly "true" AND NETWORK=mainnet AND
# TRADING_MODE=mainnet for any mainnet transaction to be attempted.
ENABLE_MAINNET_TRADING=false
